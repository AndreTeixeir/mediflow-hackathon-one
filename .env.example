# Copie este arquivo para .env e preencha somente na sua máquina.
# O .env nunca vai para o Git. Este arquivo vai, sempre sem valores.
# O código que lê estas variáveis precisa chamar load_dotenv() (python-dotenv) no início.

# LLM — Google Gemini (SDK google-genai)
# Gere sua chave gratuita no Google AI Studio (https://aistudio.google.com/apikey).
# Se vazio, o agente utiliza o motor determinístico local de fallback (útil para testes/CI).
LLM_API_KEY=
# Modelo Gemini utilizado pelo grafo (vazio = gemini-3.5-flash-lite).
# O gemini-2.5-flash não está disponível para chaves novas (a API responde 404).
LLM_MODEL=

# OCI Object Storage (Always Free)
# Região: precisa ser a região home do tenancy usado no projeto (ex.: sa-saopaulo-1)
OCI_REGION=
# Namespace do Object Storage, exibido em Perfil > Tenancy no console da OCI
OCI_NAMESPACE=
# Nome do bucket (ex.: mediflow-documentos-clinicos)
# Atenção: a API NÃO usa esta variável. Ela é só o valor padrão do campo `bucket` do contrato
# (contratos/modelos.py); a API sempre informa o bucket explicitamente (ver OCI_BUCKET_PREFIXO).
OCI_BUCKET_NAME=

# Armazenamento da API (api/ e armazenamento/)
# Modo de armazenamento: local ou oci. Vazio = local (grava em disco, sem credenciais).
# Quem desenvolve sem acesso à OCI usa local. Só quem tem credencial usa oci.
MEDIFLOW_ARMAZENAMENTO=
# Pasta do modo local, a partir da raiz do repositório. Vazio = armazenamento_local
MEDIFLOW_ARMAZENAMENTO_LOCAL_DIR=
# Autenticação do modo oci: api_key ou instance_principal. Vazio = api_key.
# api_key usa um perfil do ~/.oci/config; instance_principal é para a VM na OCI (deploy).
OCI_AUTH=
# Perfil do ~/.oci/config usado com api_key. Vazio = DEFAULT
OCI_CONFIG_PROFILE=
# Caminho do arquivo de configuração da OCI. Vazio = ~/.oci/config
OCI_CONFIG_FILE=
# Prefixo dos buckets: {prefixo}-recebidos, -urgentes, -rotina, -auditoria-humana, -rejeitados.
# Vazio = mediflow
OCI_BUCKET_PREFIXO=

# Interface -> API
# Endereço da API FastAPI usado pela interface Streamlit (ex.: http://localhost:8000)
MEDIFLOW_API_URL=
